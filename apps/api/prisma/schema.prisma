generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int               @id @default(autoincrement())
  email               String            @unique
  password            String
  banned              Boolean           @default(false)
  planId              Int?
  transferEnable      BigInt            @default(0)
  upload              BigInt            @default(0)
  download            BigInt            @default(0)
  expiredAt           DateTime?
  balance             Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastLoginAt         DateTime?
  plan                Plan?             @relation(fields: [planId], references: [id])
  sessions            Session[]
  orders              Order[]
  ledger              BalanceEntry[]
  speedLimit          Int?
  deviceLimit         Int?
  role                Role              @default(user)
  verifiedAt          DateTime?
  proxyUuid           String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscribeHash       String?           @unique
  /// Current subscription link token. subscribeHash only matches links issued before it existed.
  subscribeToken      String?           @unique
  emailTokens         EmailToken[]
  tickets             Ticket[]
  traffic             TrafficRecord[]
  /// Mailbox the address delivers to (Gmail dots and "+tag" removed); see auth/registration.ts.
  emailKey            String?
  /// Rate-limit subject (IPv4 address or IPv6 /64) the account was registered from.
  registerIp          String?
  /// This user's invite code, created on first view.
  inviteCode          String?           @unique
  invitedById         Int?
  invitedBy           User?             @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees            User[]            @relation("Invites")
  termsAcceptedAt     DateTime?
  entitlementVersion  Int               @default(0)
  trafficResetMode    TrafficResetMode  @default(none)
  trafficResetDay     Int?
  trafficResetMonth   Int?
  nextTrafficResetAt  DateTime?
  expiryReminderMask  Int               @default(0)
  trafficReminderMask Int               @default(0)
  giftRedemptions     GiftCode[]
  totpSecret          String?
  totpLastStep        BigInt?
  totpRecoveryHashes  String[]          @default([])
  locale              String?
  telegramChatId      String?           @unique
  telegramBinding     TelegramBinding?
  commissionEntries   CommissionEntry[]
  withdrawals         Withdrawal[]
  opsTokens           OpsToken[]

  @@index([planId, expiredAt])
  @@index([emailKey])
  @@index([registerIp, createdAt])
  @@index([invitedById])
  @@index([nextTrafficResetAt])
}

/// Sign-up email codes, one live code per mailbox (no account exists yet).
model RegisterCode {
  email     String   @id
  /// SHA-256 of "email:code".
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  sentAt    DateTime
}

enum BillingPeriod {
  monthly
  quarterly
  half_yearly
  yearly
  two_yearly
  three_yearly
  onetime
}

enum TrafficResetMode {
  none
  activation_day
  month_start
  year_start
  activation_anniversary
}

model Plan {
  id                     Int              @id @default(autoincrement())
  name                   String
  content                String?
  transferEnable         BigInt
  speedLimit             Int?
  deviceLimit            Int?
  published              Boolean          @default(false)
  sort                   Int              @default(0)
  trafficResetMode       TrafficResetMode @default(none)
  trafficResetPriceMinor Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  // Soft delete keeps order history intact; deleted plans are hidden everywhere.
  deletedAt              DateTime?
  prices                 PlanPrice[]
  users                  User[]
  orders                 Order[]
  nodes                  NodePlan[]
  gifts                  GiftCode[]
}

model PlanPrice {
  id          Int           @id @default(autoincrement())
  planId      Int
  period      BillingPeriod
  amountMinor Int
  currency    String        @default("CNY") @db.VarChar(3)
  plan        Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, period])
}

model Session {
  id                   String    @id
  userId               Int
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  publicId             String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAgent            String?
  pendingTotp          String?
  pendingTotpExpiresAt DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum OrderStatus {
  pending
  paid
  cancelled
}

enum OrderKind {
  subscription
  traffic_reset
}

model Order {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             Int
  planId             Int
  requestId          String           @db.Uuid
  status             OrderStatus      @default(pending)
  planName           String
  kind               OrderKind        @default(subscription)
  period             BillingPeriod?
  amountMinor        Int
  creditMinor        Int              @default(0)
  discountMinor      Int              @default(0)
  couponId           Int?
  transferBytes      BigInt
  speedLimit         Int?
  deviceLimit        Int?
  durationDays       Int
  trafficResetMode   TrafficResetMode @default(none)
  entitlementVersion Int?
  replacesPlan       Boolean          @default(false)
  priorExpiresAt     DateTime?
  serviceUntil       DateTime?
  createdAt          DateTime         @default(now())
  expiresAt          DateTime
  paidAt             DateTime?
  user               User             @relation(fields: [userId], references: [id])
  plan               Plan             @relation(fields: [planId], references: [id])
  entry              BalanceEntry?
  coupon             Coupon?          @relation(fields: [couponId], references: [id], onDelete: Restrict)

  commissionEntry CommissionEntry?
  paymentAttempts PaymentAttempt[]

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([userId, entitlementVersion])
  @@index([couponId, status])
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  amountMinor Int
  maxUses     Int
  expiresAt   DateTime?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  orders      Order[]
}

enum GiftKind {
  balance
  subscription
}

model GiftCode {
  id           Int            @id @default(autoincrement())
  digest       String         @unique
  label        String
  kind         GiftKind
  amountMinor  Int?
  planId       Int?
  period       BillingPeriod?
  expiresAt    DateTime?
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  redeemedById Int?
  redeemedAt   DateTime?
  plan         Plan?          @relation(fields: [planId], references: [id], onDelete: Restrict)
  redeemedBy   User?          @relation(fields: [redeemedById], references: [id], onDelete: Restrict)
}

model HelpArticle {
  id        Int     @id @default(autoincrement())
  title     String
  body      String
  sort      Int     @default(0)
  published Boolean @default(false)
}

model MailTemplate {
  key     String @id
  subject String
  text    String
}

model MailBroadcast {
  requestId  String @id @db.Uuid
  actorId    Int
  digest     String
  recipients Int
}

model BalanceEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      Int
  orderId     String?  @unique @db.Uuid
  requestId   String?  @unique @db.Uuid
  reason      String?
  actorId     Int?
  amountMinor Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
}

enum Role {
  user
  admin
}

model Audit {
  id         Int              @id @default(autoincrement())
  actorId    Int
  action     String
  target     String
  detail     Json
  createdAt  DateTime         @default(now())
  opsTokenId String?          @db.Uuid
  opsChanges OpsAuditChange[]

  @@index([opsTokenId, id])
}

model OpsToken {
  id          String            @id @default(uuid()) @db.Uuid
  tokenHash   String            @unique
  name        String
  scopes      String[]          @default(["*"])
  allowedIps  String[]          @default([])
  createdById Int
  createdAt   DateTime          @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  createdBy   User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  requests    OpsWriteRequest[]
}

model OpsWriteRequest {
  tokenId     String   @db.Uuid
  key         String   @db.Uuid
  fingerprint String
  status      Int
  createdAt   DateTime @default(now())
  /// Encrypted with a key derived from the caller's Bearer token.
  response    Bytes
  token       OpsToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, key])
  @@index([createdAt])
}

model OpsAuditChange {
  id            BigInt   @id @default(autoincrement())
  auditId       Int
  resource      String
  record        String
  before        Json?
  after         Json?
  privateFields String[] @default([])
  audit         Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId, id])
}

model EmailToken {
  hash      String   @id
  userId    Int
  purpose   String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mail {
  id          Int       @id @default(autoincrement())
  to          String
  subject     String
  text        String
  attempts    Int       @default(0)
  sentAt      DateTime?
  nextAttempt DateTime  @default(now())
  lastError   String?
  createdAt   DateTime  @default(now())
}

enum NodeProtocol {
  vmess
  vless
  trojan
  shadowsocks
  hysteria2
  tuic
  hysteria
  anytls
  socks
  http
  naive
  mieru
}

model Node {
  id               Int              @id @default(autoincrement())
  name             String
  protocol         NodeProtocol
  host             String
  /// The port clients dial.
  port             Int
  /// The port the node software listens on.
  serverPort       Int
  /// Protocol options, validated by NODE_SETTINGS[protocol] in @xboard/contracts.
  settings         Json             @default("{}")
  /// Secret behind the Shadowsocks 2022 server key; never shown.
  serverSecret     String           @default(dbgenerated("md5((random())::text)"))
  enabled          Boolean          @default(false)
  /// Listed in subscriptions; a hidden node still serves its users.
  visible          Boolean          @default(true)
  tags             String[]         @default([])
  /// Traffic multiplier applied when the node reports usage.
  rate             Float            @default(1)
  /// [{ start: "HH:MM", end: "HH:MM", rate }] in Asia/Shanghai; first match wins.
  rateRanges       Json             @default("[]")
  /// V2bX route rules, custom outbounds/routes and certificate settings sent to the node.
  routes           Json             @default("[]")
  customOutbounds  Json             @default("[]")
  customRoutes     Json             @default("[]")
  certConfig       Json             @default("{}")
  /// A relay entry: listed with its own address, served by the parent's backend.
  parentId         Int?
  parent           Node?            @relation("NodeRelay", fields: [parentId], references: [id], onDelete: Restrict)
  children         Node[]           @relation("NodeRelay")
  tokenHash        String
  lastSeenAt       DateTime?
  offlineAlertedAt DateTime?
  status           Json?
  createdAt        DateTime         @default(now())
  // Soft delete keeps traffic history; deleted nodes are disabled and keyless.
  deletedAt        DateTime?
  plans            NodePlan[]
  traffic          TrafficRecord[]
  receipts         TrafficReceipt[]
  online           OnlineDevice[]

  @@index([parentId])
}

model NodePlan {
  nodeId Int
  planId Int
  node   Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  plan   Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@id([nodeId, planId])
}

model TrafficRecord {
  id        BigInt   @id @default(autoincrement())
  nodeId    Int
  userId    Int
  upload    BigInt
  download  BigInt
  createdAt DateTime @default(now())
  node      Node     @relation(fields: [nodeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
}

model TrafficReceipt {
  nodeId    Int
  key       String
  digest    String
  createdAt DateTime @default(now())
  node      Node     @relation(fields: [nodeId], references: [id])

  @@id([nodeId, key])
}

model OnlineDevice {
  nodeId Int
  userId Int
  ip     String
  seenAt DateTime @default(now())
  node   Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, userId, ip])
}

model Notice {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Ticket {
  id        Int             @id @default(autoincrement())
  userId    Int
  subject   String
  closed    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  messages  TicketMessage[]

  @@index([userId, updatedAt])
}

model TicketMessage {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  isStaff   Boolean
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
}

model RateLimit {
  key          String    @id
  hits         Int
  expiresAt    DateTime
  blockedUntil DateTime?
}

// Site-wide settings as key/value rows; defaults live in SettingsService.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// An admin's replacement for a built-in subscription template; no row means the default is used.
model SubscriptionTemplate {
  format    String   @id
  content   String
  updatedAt DateTime @updatedAt
}

model BackupRun {
  id           String    @id @default(uuid()) @db.Uuid
  scheduledDay String?   @unique
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  bytes        BigInt?
  objects      String[]  @default([])

  @@index([createdAt])
}

enum PaymentKind {
  epay
  stripe
}

enum PaymentStatus {
  pending
  settled
  credited
  review
}

model PaymentGateway {
  id                    Int              @id @default(autoincrement())
  name                  String
  kind                  PaymentKind
  enabled               Boolean          @default(false)
  sortOrder             Int              @default(0)
  icon                  String?
  feePercentBasisPoints Int              @default(0)
  feeFixedMinor         Int              @default(0)
  config                Json
  secrets               String
  attempts              PaymentAttempt[]
}

model PaymentAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  orderId           String         @db.Uuid
  gatewayId         Int
  requestId         String         @db.Uuid
  amountMinor       Int
  feeMinor          Int
  status            PaymentStatus  @default(pending)
  config            Json
  /// Retired: callbacks use the gateway's current secrets. Old copies are cleared.
  secrets           String?
  checkoutUrl       String?
  providerReference String?        @unique
  externalId        String?
  receivedAt        DateTime?
  createdAt         DateTime       @default(now())
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  gateway           PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Restrict)

  @@unique([orderId, requestId])
  @@unique([gatewayId, externalId])
  @@index([createdAt])
}

enum CommissionKind {
  reward
  transfer
  withdrawal
  reversal
}

enum WithdrawalStatus {
  pending
  paid
  rejected
}

model CommissionEntry {
  id           String         @id @default(uuid()) @db.Uuid
  userId       Int
  kind         CommissionKind
  amountMinor  Int
  orderId      String?        @unique @db.Uuid
  requestId    String?        @db.Uuid
  withdrawalId String?        @db.Uuid
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  order        Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  withdrawal   Withdrawal?    @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@unique([userId, requestId])
  @@unique([withdrawalId, kind])
  @@index([userId, createdAt])
}

model Withdrawal {
  id          String            @id @default(uuid()) @db.Uuid
  userId      Int
  requestId   String            @db.Uuid
  amountMinor Int
  method      String
  recipient   String
  status      WithdrawalStatus  @default(pending)
  reason      String?
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime          @default(now())
  user        User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries     CommissionEntry[]

  @@unique([userId, requestId])
  @@index([status, createdAt])
}

model TelegramBinding {
  userId    Int      @id
  digest    String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model TelegramNotice {
  id        String    @id @default(uuid()) @db.Uuid
  chatId    String
  eventKey  String
  message   String
  attempts  Int       @default(0)
  nextAt    DateTime  @default(now())
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([chatId, eventKey])
  @@index([sentAt, nextAt])
}
