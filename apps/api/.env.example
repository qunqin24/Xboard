# Application configuration.
NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://xboard:xboard_local@127.0.0.1:55432/xboard
# Required only when creating the synthetic development account.
DEMO_EMAIL=developer@example.test
DEMO_PASSWORD=
# Local SMTP capture: docker compose -f compose.typescript.yaml up -d mailpit
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=Xboard <noreply@example.test>
# Bootstrap via pnpm --filter @xboard/api admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional HTTPS endpoint accepting JSON failure alerts.
ALERT_WEBHOOK_URL=
# Required to let users enable two-factor authentication (empty: setup is refused,
# password sign-in keeps working). Exactly 32 random bytes, base64url, 43 characters:
#   node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64url"))'
# Keep one value on every API instance and keep it across restarts and restores.
# Changing or losing it makes existing TOTP secrets unreadable: those users can
# then sign in only with an unused recovery code, and must set up two-factor again.
TOTP_ENCRYPTION_KEY=
