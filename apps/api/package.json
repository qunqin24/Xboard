{
    "name": "@xboard/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --clear-screen=false src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
        "db:setup": "node scripts/setup-database.mjs",
        "db:seed": "tsx scripts/seed.ts",
        "admin:create": "tsx scripts/admin.ts",
        "openapi": "tsx scripts/openapi.ts"
    },
    "dependencies": {
        "@prisma/client": "6.19.3",
        "@xboard/contracts": "workspace:*",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.2.3",
        "express": "^5.3.0",
        "helmet": "^8.3.0",
        "nodemailer": "^7.0.0",
        "prisma": "6.19.3",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.0",
        "@types/nodemailer": "^7.0.0",
        "@types/swagger-ui-express": "^4.1.8",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "typescript": "~5.9.3"
    },
    "type": "module"
}
