APP_DOMAIN=panel.example.com
APP_ORIGIN=https://panel.example.com
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
# SMTP credentials are optional until email features are enabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Xboard <noreply@example.com>
# Optional HTTPS endpoint accepting JSON failure alerts.
ALERT_WEBHOOK_URL=
# Required to enable two-factor. 32 random bytes, base64url (see docs/typescript-deployment.md).
# Same value on every API instance; changing it breaks existing 2FA users (recovery codes still work).
TOTP_ENCRYPTION_KEY=
