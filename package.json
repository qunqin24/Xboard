{
  "name": "xboard-workspace",
  "private": true,
  "packageManager": "pnpm@11.0.3",
  "engines": {
    "node": ">=22.12 <26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @xboard/api --filter @xboard/user dev",
    "build": "pnpm --filter @xboard/api build && pnpm --filter @xboard/user build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @xboard/api test && pnpm --filter @xboard/user test",
    "db:setup": "pnpm --filter @xboard/api db:setup",
    "db:seed": "pnpm --filter @xboard/api db:seed",
    "api:generate": "pnpm --filter @xboard/api openapi && pnpm --filter @xboard/api-client generate",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,tsx,json}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
